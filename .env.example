# Edge Scanner 2 Environment Variables
# These keys are optional. In AI Studio and local development, live provider calls
# run through the server-side proxy without exposing keys to the browser bundle.

# API-Sports American Football key (for live NFL games and player passing stats)
API_SPORTS_NFL_KEY=

# API-Sports Basketball key (for live NBA team stats and completed game form)
API_SPORTS_NBA_KEY=

# Unified API-Sports key (fallback if separate NFL/NBA keys are not set)
API_SPORTS_KEY=

# The Odds API key (for live US sportsbook comparison)
THE_ODDS_API_KEY=

# Google Gemini API key (optional server-side assistance)
GEMINI_API_KEY=
